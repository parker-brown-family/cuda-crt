#!/usr/bin/env python3
"""Open the repository sliders against the live CUDA CRT, or --serve them."""
import argparse
import copy
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time
import urllib.error
import urllib.request
from http.server import ThreadingHTTPServer

import live_dials
from knobs import Handler, Knobs, number

ROOT = Path(__file__).resolve().parent.parent
PORT = 8788


def publish(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as f:
            temporary = Path(f.name)
            f.write(data); f.flush(); os.fsync(f.fileno())
        temporary.replace(path)
    finally:
        if temporary:
            temporary.unlink(missing_ok=True)


class LiveKnobs(Knobs):
    def __init__(self, state):
        self.state = Path(state)
        self.live = False
        dials, presets = live_dials.load()
        super().__init__(dials, presets, self.state / "controls.json")
        self.seen = None
        self.adopt()
        self.current["preset"] = None
        self.live = True  # Opening the panel does not change the active effect.

    def adopt(self):
        """Take up what is on disk: DOOM's own menu writes the same files."""
        source = self.state / "tube-profile.set"
        if not source.exists():
            source = self.state / "set"
        text = source.read_text() if source.exists() else ""
        if text == self.seen:
            return
        restored, extra = {}, {}
        for part in text.replace("\n", ",").split(","):
            if "=" not in part:
                continue
            key, value = (p.strip() for p in part.split("=", 1))
            if key in self.by_name:
                try:
                    restored[key] = number(float(value))
                except ValueError:
                    continue
            else:
                extra[key] = value
        values = {**{d["name"]: d["default"] for d in self.dials}, **self.clamp(restored)}
        if self.seen is not None and values != self.current["values"]:
            self.current = {"rev": self.current["rev"] + 1, "preset": None, "values": values}
        else:
            self.current["values"] = values
        self.extra, self.seen = extra, text

    def snapshot(self):
        with self.lock:
            self.adopt()
            return copy.deepcopy(self.current)

    def set(self, values, preset=None):
        if not self.live:
            return super().set(values, preset)
        values = self.clamp(values)
        if preset is not None and (not isinstance(preset, str) or preset not in self.presets):
            raise ValueError("unknown preset")
        with self.lock:
            self.adopt()
            next_state = {"rev": self.current["rev"] + 1, "preset": preset,
                          "values": {**self.current["values"], **values}}
            pairs = {**self.extra, **next_state["values"]}
            data = (",".join(f"{k}={v}" for k, v in pairs.items()) + "\n").encode()
            publish(self.state / "tube-profile.set", data)
            publish(self.state / "set", data)
            self.current, self.seen = next_state, data.decode()
            return copy.deepcopy(next_state)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--state", type=Path, default=Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "cuda-crt")
    args = parser.parse_args()
    if args.serve:
        server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
        try:
            server.knobs = LiveKnobs(args.state)
            print(f"Live CRT controls: http://127.0.0.1:{PORT}/", flush=True)
            server.serve_forever()
        finally:
            server.server_close()
        return
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/" + str(os.getuid()))
    env.setdefault("DBUS_SESSION_BUS_ADDRESS", "unix:path=" + env["XDG_RUNTIME_DIR"] + "/bus")
    if not env.get("WAYLAND_DISPLAY"):
        instances = json.loads(subprocess.check_output(["hyprctl", "instances", "-j"], env=env))
        if len(instances) != 1:
            raise RuntimeError("Select your compositor with WAYLAND_DISPLAY before opening the panel.")
        env["WAYLAND_DISPLAY"] = instances[0]["wl_socket"]
    active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "cuda-crt-controls.service"], env=env).returncode == 0
    if not active:
        subprocess.run(["systemd-run", "--user", "--unit=cuda-crt-controls", "--collect",
                        str(Path(__file__).resolve()), "--serve", "--state", str(args.state)], env=env, check=True)
    for _ in range(50):
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/api/knobs", timeout=1) as response:
                if isinstance(json.load(response).get("values"), dict):
                    break
        except (urllib.error.URLError, ValueError):
            pass
        time.sleep(0.1)
    else:
        raise RuntimeError("The CRT panel service did not become ready; inspect cuda-crt-controls.service.")
    subprocess.run(["systemd-run", "--user", "--unit=cuda-crt-controls-window-" + str(os.getpid()), "--collect",
                    "--slice=app.slice", "--setenv=WAYLAND_DISPLAY=" + env["WAYLAND_DISPLAY"],
                    "--setenv=XDG_RUNTIME_DIR=" + env["XDG_RUNTIME_DIR"], "/usr/bin/chromium",
                    "--ozone-platform=wayland", "--app=http://127.0.0.1:" + str(PORT) + "/"], env=env, check=True)


if __name__ == "__main__":
    main()
