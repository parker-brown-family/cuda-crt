#!/usr/bin/env python3
"""Prove the CUDA CRT can run inside Hyprland, in a sealed seat.  hypr/prove <state-dir> <out-dir>

The seat is omarchy-crt's: a sandbox with no display device, no input and no live
Wayland socket (native/sandbox), with a headless Hyprland started inside it
(native/rig/up). Point OMARCHY_CRT at a checkout of that repository. Nothing here
can reach a live desktop.

Checks, in order:
  1. the plugin loads and CUDA shares this compositor's own GLES textures
  2. the picture changes: the frame with the pass differs from the frame without
  3. what a frame costs in here (wall time, GPU finished either side)
  4. an empty desk goes quiet; a window appearing wakes the pass; a still window goes quiet again
  5. a failure injected mid-frame leaves the compositor answering and the picture untouched
  6. the plugin unloads and the compositor keeps answering
"""
import json, os, signal, struct, subprocess, sys, time, zlib

S, OUT = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OMA = os.environ.get("OMARCHY_CRT", os.path.expanduser("~/Work/omarchy-crt"))
HOME = S + "/home"
os.makedirs(OUT, exist_ok=True)
fails = 0
results = []


def verdict(ok, text, measured=""):
    global fails
    fails += 0 if ok else 1
    results.append({"pass": bool(ok), "check": text, "measured": measured})
    print(f"  {'ok  ' if ok else 'FAIL'} {text}  {measured}", flush=True)


def seat(*cmd, timeout=8):
    return subprocess.run([S + "/in", *cmd], capture_output=True, text=True, timeout=timeout)


def flag(name, on=True):
    p = f"{HOME}/{name}"
    if on:
        open(p, "w").close()
    elif os.path.exists(p):
        os.unlink(p)


def alive():
    try:
        return '"name"' in seat("hyprctl", "monitors", "-j", timeout=5).stdout
    except subprocess.TimeoutExpired:
        return False


def shot(name):
    """Ask the plugin for the finished frame; returns (w, h, bytes) and writes a PNG."""
    for f in ("frame.rgba", "frame.txt"):
        if os.path.exists(f"{HOME}/{f}"):
            os.unlink(f"{HOME}/{f}")
    flag("dump-now")
    for _ in range(120):
        if os.path.exists(f"{HOME}/frame.txt") and not os.path.exists(f"{HOME}/dump-now"):
            break
        time.sleep(0.05)
    else:
        return None
    time.sleep(0.1)
    meta = open(f"{HOME}/frame.txt").read().split()
    w, h = int(meta[0]), int(meta[1])
    px = open(f"{HOME}/frame.rgba", "rb").read()
    raw = b"".join(b"\0" + px[y * w * 4:(y + 1) * w * 4] for y in range(h))
    ch = lambda t, d: struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d))
    open(f"{OUT}/{name}.png", "wb").write(b"\x89PNG\r\n\x1a\n" + ch(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 0)) + ch(b"IDAT", zlib.compress(raw, 3)) + ch(b"IEND", b""))
    return w, h, px


def frames():
    try:
        return int(open(f"{HOME}/cuda-frames.now").read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def log():
    try:
        return open(f"{HOME}/cuda-pass.log").read()
    except OSError:
        return ""


def differ(a, b):
    return sum(1 for i in range(0, len(a), 4 * 97) if a[i:i + 3] != b[i:i + 3]) / max(1, len(a) // (4 * 97))


print("building the plugin and starting the sealed seat")
os.makedirs(HOME, exist_ok=True)
for f in ("cuda-pass.log", "cuda-pass-ms.txt", "cuda-frames.now", "cuda-off", "cuda-fail", "still-glass", "keep-drawing", "time-pass", "dump-now"):
    flag(f, False)
subprocess.run([HERE + "/hypr/build", HOME + "/cuda-pass.so"], check=True, stdout=subprocess.DEVNULL)
subprocess.run([OMA + "/native/rig/up", S], check=True, env={**os.environ, "CRT_SEAT": os.environ.get("CRT_SEAT", "HEADLESS-1 1920x1080@60 1 0 0 0")})
open(HOME + "/cuda-crt-root", "w").write(HERE + "\n")
subprocess.run(["rm", "-rf", HOME + "/cuda-client"]); subprocess.run(["cp", "-r", HERE + "/hypr/client", HOME + "/cuda-client"], check=True)
clients = []


def windows():
    return seat("hyprctl", "clients", "-j").stdout.count('"class"')


def start_client(name):
    """term = text that types itself; still = the same text, complete, nothing moving."""
    want = windows() + 1
    c = subprocess.Popen([S + "/in", "env", "QT_QPA_PLATFORM=wayland", "QS_NO_RELOAD_POPUP=1", "quickshell", "-p", f"{HOME}/cuda-client/{name}.qml"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    clients.append(c)
    for _ in range(60):
        if windows() >= want:
            break
        time.sleep(0.25)
    return c


def stop_clients():
    """Kill every client's whole process group, then wait until the compositor shows no window."""
    for c in clients:
        try:
            os.killpg(os.getpgid(c.pid), signal.SIGKILL)
        except ProcessLookupError:
            pass
    clients.clear()
    for _ in range(40):
        if windows() == 0:
            return True
        time.sleep(0.25)
    return False


start_client("term")
try:
    # the frame WITHOUT the pass, for comparison (the pass is off before the plugin even loads)
    flag("cuda-off"); flag("keep-drawing")
    loaded = seat("hyprctl", "plugin", "load", HOME + "/cuda-pass.so").stdout.strip().splitlines()[-1:]
    print("  plugin load:", loaded)
    time.sleep(1.5)
    plain = shot("1-without-the-pass")
    flag("cuda-off", False)
    time.sleep(2.5)
    print("1. CUDA inside the compositor")
    l = log()
    verdict("ready:" in l and "registered with CUDA" in l and "DEAD" not in l, "the plugin initialised CUDA and registered the compositor's GLES textures",
            (l.strip().splitlines() or ["no log"])[-1][:150])
    print("2. the picture")
    time.sleep(3.0)
    crt = shot("2-with-the-pass")
    d = differ(plain[2], crt[2]) if plain and crt else 0
    verdict(plain is not None and crt is not None and d > 0.2, "the frame through the pass differs from the frame without it", f"{100 * d:.0f}% of sampled pixels differ, {crt[0]}x{crt[1]}" if crt else "no frame")
    print("3. what a frame costs in here")
    flag("time-pass"); time.sleep(4.0); flag("time-pass", False)
    try:
        avg, mx, n, size = open(f"{HOME}/cuda-pass-ms.txt").read().split()
        verdict(float(avg) < 3.0, "whole pass, wall clock with the GPU finished either side (copy in, map, three kernels, unmap, copy back)", f"mean {float(avg):.2f} ms, worst {float(mx):.2f} ms over {n} frames at {size}")
    except (OSError, ValueError):
        verdict(False, "pass timing was written", "no cuda-pass-ms.txt")
    print("4. idle")
    gone = stop_clients()
    flag("still-glass"); flag("keep-drawing", False)
    time.sleep(6.0)  # the ghost drains in about three seconds
    a = frames(); time.sleep(2.0); b = frames()
    verdict(gone and a is not None and a == b, "an empty desk, glass still: the pass stops being asked for frames", f"{a} frames, then {b} two seconds later")
    # An idle compositor draws nothing, so nothing would ever read a switch: a window
    # appearing is what wakes it, exactly as on a real desk.
    start_client("still")
    time.sleep(1.0)
    woke = frames()
    verdict(woke is not None and b is not None and woke > b, "a window appearing wakes the pass", f"{b} frames while idle, {woke} a second after a window opened")
    time.sleep(7.0)  # its text charges the ghost for a couple of seconds, then everything settles
    c1 = frames(); time.sleep(2.0); c2 = frames()
    verdict(c1 is not None and c1 == c2, "a still window on screen: the pass goes quiet again", f"{c1} frames, then {c2} two seconds later")
    flag("keep-drawing")
    start_client("still")  # a second window, to wake the seat so the switch above is read
    time.sleep(1.5)
    print("5. a failure mid-frame")
    flag("cuda-fail"); time.sleep(1.5)
    l = log()
    ok_alive = alive()
    after_fail = shot("5-after-the-failure")
    flag("cuda-off"); time.sleep(0.6)
    plain2 = shot("5-plain-for-comparison")
    same = after_fail is not None and plain2 is not None and differ(after_fail[2], plain2[2]) < 0.002
    verdict("DEAD" in l and ok_alive, "the failure was caught, logged, and the compositor still answers", (l.strip().splitlines() or [""])[-1][:120])
    verdict(same, "after the failure the frame is the untouched picture", "identical to the frame with the pass off" if same else "differs from the plain frame")
    print("6. unload")
    seat("hyprctl", "plugin", "unload", HOME + "/cuda-pass.so")
    time.sleep(1.0)
    verdict(alive(), "the plugin unloads and the compositor keeps answering")
finally:
    stop_clients()
    subprocess.run(["pkill", "-f", "[H]yprland --config " + HOME], check=False)
    time.sleep(0.5)
json.dump({"failed": fails, "checks": results, "log": log().strip().splitlines()}, open(f"{OUT}/hypr-proof.json", "w"), indent=1)
print("all checks passed" if not fails else f"{fails} FAILED")
sys.exit(1 if fails else 0)
