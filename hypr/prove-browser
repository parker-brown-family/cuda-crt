#!/usr/bin/env python3
"""A real browser under the pass, watched for a freeze and for lost input.  hypr/prove-browser <state-dir> <out-dir> [seconds]

In omarchy-crt's sealed seat (as hypr/prove): Chromium shows hypr/client/alive.html,
a counter that changes on every animation frame and a background that flips colour
on every click. The pass is aimed at that window with the full tube look. Every few
seconds the frame is captured: the counter must have moved (the picture is live) and
a click must flip the background (input arrives). Set PROVE_SET for the overrides."""
import json, os, subprocess, sys, time
S, OUT = os.path.abspath(sys.argv[1]), os.path.abspath(sys.argv[2])
SECS = int(sys.argv[3]) if len(sys.argv) > 3 else 120
HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.argv = [sys.argv[0], S, OUT]
src = open(HERE + "/hypr/prove").read()
src = src[:src.index('which = sys.argv[3]')]   # the helpers only: verdict, seat, put, drop, shot, frames, log, up, down
exec(compile(src, "hypr/prove", "exec"))
OMA_RIG = OMA + "/native/rig"
up("HEADLESS-1 2560x1600@60 1.6 0 0 0")
# the virtual pointer, as omarchy-crt's rig builds it
X = OMA_RIG + "/wlr-virtual-pointer-unstable-v1.xml"
subprocess.run(["wayland-scanner", "client-header", X, HOME + "/vp.h"], check=True)
subprocess.run(["wayland-scanner", "private-code", X, HOME + "/vp.c"], check=True)
subprocess.run("gcc -O1 -I%s %s/vptr.c %s/vp.c -o %s/vptr $(pkg-config --cflags --libs wayland-client)" % (HOME, OMA_RIG, HOME, HOME), shell=True, check=True)
FIFO = HOME + "/vptr.fifo"
vp = subprocess.Popen([S + "/in", HOME + "/vptr", FIFO, "1600", "1000"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
page = HOME + "/alive.html"
subprocess.run(["cp", HERE + "/hypr/client/alive.html", page], check=True)
br = subprocess.Popen([S + "/in", "chromium", "--ozone-platform=wayland", "--no-sandbox", "--user-data-dir=" + HOME + "/chromium", "--no-first-run",
                       "--no-default-browser-check", "--disable-features=Translate", "--new-window", "file://" + page],
                      stdout=open(HOME + "/chromium.log", "w"), stderr=subprocess.STDOUT, start_new_session=True)
clients.append(br); clients.append(vp)
win = None
for _ in range(80):
    win = next((c for c in windows() if c.get("class") == "chromium"), None)
    if win and "alive" in win.get("title", ""):
        break
    time.sleep(0.25)
print("  browser window:", win and (win["at"], win["size"], win["title"]))
cx, cy = win["at"][0] + win["size"][0] // 2, win["at"][1] + win["size"][1] // 2   # logical pixels
put("target", "class:chromium"); put("look", os.environ.get("PROVE_LOOK", "tube")); put("ttl", str(SECS + 60))
if os.environ.get("PROVE_SET"):
    put("set", os.environ["PROVE_SET"])
# CYCLES=n replays what happened on the live desktop first: n times, a new build file
# is loaded, runs on the window for RUN seconds, and is unloaded, before the watched run.
SO = HOME + "/cuda-pass.so"
for c in range(int(os.environ.get("CYCLES", "0"))):
    so = "%s/cuda-pass-cycle%d.so" % (HOME, c)
    subprocess.run(["cp", SO, so], check=True)
    seat("hyprctl", "plugin", "load", so)
    time.sleep(float(os.environ.get("RUN", "8")))
    seat("hyprctl", "plugin", "unload", so)
    time.sleep(1.0)
    print("  cycle %d: loaded, ran, unloaded; compositor answering: %s" % (c + 1, alive()), flush=True)
SO_FINAL = HOME + "/cuda-pass-final.so"
subprocess.run(["cp", SO, SO_FINAL], check=True)
print("  plugin load:", seat("hyprctl", "plugin", "load", SO_FINAL).stdout.strip().splitlines()[-1:])
open(FIFO, "w").write("move %d %d\n" % (cx - 300, cy))   # the pointer rests left of the counter


def region(fr, x0, y0, w, h):
    W = fr[0]
    return b"".join(fr[2][(y * W + x0) * 4:(y * W + x0 + w) * 4] for y in range(y0, y0 + h))


def mean_rgb(buf):
    n = len(buf) // 4
    return tuple(sum(buf[i::4][:n]) / n for i in range(3))


try:
    time.sleep(3)
    t_end, k, prev, flips_seen, clicks, frozen, deaf, rows = time.time() + SECS, 0, None, 0, 0, 0, 0, []
    px, py = int(cx * 1.6), int(cy * 1.6)              # the window centre in framebuffer pixels
    bx, by = int((win["at"][0] + 40) * 1.6), int((win["at"][1] + 120) * 1.6)   # a patch of background, inside the flat middle... near the left
    bx = int((cx - 420) * 1.6)
    while time.time() < t_end:
        k += 1
        fr = shot("alive-%03d" % k) if k % 6 == 1 else shot("_tmp")
        if fr is None:
            frozen += 1
            rows.append({"t": k, "frame": None, "alive": alive()})
            print("  t%3d  NO FRAME (compositor answering: %s)" % (k, alive()))
            time.sleep(2); continue
        cnt = region(fr, px - 280, py - 90, 560, 180)
        live = prev is None or cnt != prev
        frozen += 0 if live else 1
        prev = cnt
        before = mean_rgb(region(fr, bx, py - 40, 60, 80))
        open(FIFO, "w").write("click\n"); clicks += 1
        time.sleep(0.6)
        fr2 = shot("_tmp2")
        after = mean_rgb(region(fr2, bx, py - 40, 60, 80)) if fr2 else before
        flipped = abs(after[0] - before[0]) + abs(after[2] - before[2]) > 30
        deaf += 0 if flipped else 1
        f = frames()
        rows.append({"t": k, "counter_moved": live, "click_flipped": flipped, "pass_frames": f, "bg_before": [round(v) for v in before], "bg_after": [round(v) for v in after]})
        print("  t%3d  picture %s   click %s   pass frames %s   bg %s -> %s" % (k, "live" if live else "FROZEN", "arrived" if flipped else "LOST", f, [round(v) for v in before], [round(v) for v in after]), flush=True)
        time.sleep(2.0)
    try:
        perf = open(FL + "/perf.csv").read().strip().splitlines()
    except OSError:
        perf = []
    verdict(frozen == 0, "the browser's picture kept moving under the pass the whole time", "%d of %d checks frozen" % (frozen, k))
    verdict(deaf == 0, "every click reached the browser", "%d of %d clicks lost" % (deaf, clicks))
    verdict("DEAD" not in log(), "the pass never failed", (log().strip().splitlines() or [""])[-1][:100])
    verdict(alive(), "the compositor still answers")
    json.dump({"failed": fails, "checks": results, "rows": rows, "perf": perf, "log": log().splitlines()}, open(OUT + "/browser-proof.json", "w"), indent=1)
finally:
    seat("hyprctl", "plugin", "unload", SO_FINAL)
    down()
print("all checks passed" if not fails else "%d FAILED" % fails)
sys.exit(1 if fails else 0)
